install.packages("rmarkdown")
library(tidyverse)
library(httr)
library(jsonlite)
query <- '
SELECT ?person ?personLabel ?gender ?genderLabel ?film ?filmLabel ?genre ?genreLabel
WHERE {
?person wdt:P106 wd:Q33999 .       # Beruf: Schauspieler*in
?person wdt:P21  ?gender .          # Geschlecht
?film   wdt:P161 ?person .          # Film mit dieser Person
?film   wdt:P136 ?genre .           # Genre des Films
FILTER(?gender IN (wd:Q6581072, wd:Q6581097))  # nur m/w
SERVICE wikibase:label { bd:serviceParam wikibase:language "de,en" }
}
LIMIT 20000
'
url <- paste0(
"https://query.wikidata.org/sparql?query=",
URLencode(query),
"&format=json"
)
response <- GET(url, add_headers("User-Agent" = "GenderFilmAnalysis/1.0"))
raw      <- content(response, as = "text", encoding = "UTF-8")
data     <- fromJSON(raw)
library(tidyverse)
library(httr)
library(jsonlite)
