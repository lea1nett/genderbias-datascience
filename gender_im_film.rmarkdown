```{r setup, include=FALSE}
library(tidyverse)
library(httr)
library(jsonlite)
```



# Einleitung

*\[Hier: Motivation, warum Genderrepräsentation im Film relevant ist. Forschungsfrage formulieren.\]*

**Forschungsfrage:** Unterscheidet sich die Genreverteilung von Filmen, in denen Schauspielerinnen vs. Schauspieler auftreten – und wenn ja, wie?

# WikiData als Datenquelle

*\[Hier: Kurze Erklärung was WikiData ist, wie SPARQL funktioniert, und welche Limitierungen die Quelle hat (z.B. unvollständige Einträge, kein vollständiges Abbild der Branche).\]*

## SPARQL-Abfrage

Die Daten wurden über den WikiData Query Service (`query.wikidata.org`) erhoben. Die folgende Abfrage holt alle Schauspieler\*innen mit mindestens einem verknüpften Film und Genre:



```{r sparql-query, cache=TRUE}
query <- '
SELECT ?person ?personLabel ?gender ?genderLabel ?film ?filmLabel ?genre ?genreLabel
WHERE {
  ?person wdt:P106 wd:Q33999 .       # Beruf: Schauspieler*in
  ?person wdt:P21  ?gender .          # Geschlecht
  ?film   wdt:P161 ?person .          # Film mit dieser Person
  ?film   wdt:P136 ?genre .           # Genre des Films
  FILTER(?gender IN (wd:Q6581072, wd:Q6581097))  # nur m/w
  SERVICE wikibase:label { bd:serviceParam wikibase:language "de,en" }
}
LIMIT 20000
'

url <- paste0(
  "https://query.wikidata.org/sparql?query=",
  URLencode(query),
  "&format=json"
)

response <- GET(url, add_headers("User-Agent" = "GenderFilmAnalysis/1.0"))
raw      <- content(response, as = "text", encoding = "UTF-8")
data     <- fromJSON(raw)

df_raw <- data$results$bindings |>
  as_tibble() |>
  transmute(
    person      = person$value,
    personLabel = personLabel$value,
    gender      = genderLabel$value,
    film        = film$value,
    filmLabel   = filmLabel$value,
    genre       = genreLabel$value
  )

glimpse(df_raw)
```



# Methodik & Stichprobe

*\[Hier: Wie wurde gefiltert? Warum welche Mindestanzahl an Filmen? Was wurde bereinigt?\]*



```{r datenbereinigung}
df <- df_raw |>
  # Geschlecht vereinheitlichen
  mutate(gender = case_when(
    gender == "female" ~ "Schauspielerinnen",
    gender == "male"   ~ "Schauspieler",
    TRUE               ~ NA_character_
  )) |>
  filter(!is.na(gender)) |>
  # Nur Personen mit mind. 3 Filmkredits
  group_by(person) |>
  filter(n_distinct(film) >= 3) |>
  ungroup()

# Überblick Stichprobe
df |>
  distinct(person, gender) |>
  count(gender, name = "Anzahl Personen")
```



# Ergebnisse

## Gesamtverteilung nach Geschlecht

*\[Hier: Kurzer Text zur Grundverteilung – wie viele Männer/Frauen sind in der Stichprobe?\]*



```{r abb-grundverteilung, fig.cap="Abbildung 1: Anzahl Personen nach Geschlecht"}
df |>
  distinct(person, gender) |>
  count(gender) |>
  ggplot(aes(x = gender, y = n, fill = gender)) +
  geom_col(show.legend = FALSE) +
  labs(
    title = "Schauspieler*innen in der Stichprobe",
    x = NULL, y = "Anzahl Personen"
  ) +
  theme_minimal()
```



## Genreverteilung nach Geschlecht

*\[Hier: Hauptergebnis beschreiben. Welche Genres dominieren bei Frauen, welche bei Männern? Was fällt besonders auf?\]*



```{r abb-genre, fig.cap="Abbildung 2: Top-Genres nach Geschlecht (normalisiert)"}
df |>
  count(gender, genre) |>
  group_by(gender) |>
  mutate(anteil = n / sum(n)) |>
  slice_max(anteil, n = 10) |>
  ggplot(aes(x = reorder(genre, anteil), y = anteil, fill = gender)) +
  geom_col(show.legend = FALSE) +
  coord_flip() +
  facet_wrap(~gender, scales = "free_y") +
  labs(
    title = "Top 10 Genres nach Geschlecht",
    x = NULL, y = "Anteil (normalisiert)"
  ) +
  theme_minimal()
```



## Genrekonzentration im Vergleich

*\[Hier: Sind Frauen auf weniger Genres konzentriert als Männer? Gibt es "typisch weibliche" oder "typisch männliche" Genres?\]*



```{r abb-konzentration, fig.cap="Abbildung 3: Genrekonzentration nach Geschlecht"}
df |>
  count(gender, genre) |>
  group_by(gender) |>
  mutate(anteil = n / sum(n)) |>
  ggplot(aes(x = anteil, fill = gender)) +
  geom_histogram(bins = 30, alpha = 0.7, position = "identity") +
  facet_wrap(~gender) +
  labs(
    title = "Verteilung der Genreanteile",
    x = "Anteil pro Genre", y = "Häufigkeit"
  ) +
  theme_minimal() +
  theme(legend.position = "none")
```



